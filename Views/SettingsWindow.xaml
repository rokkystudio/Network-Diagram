<Window x:Class="NetworkDiagram.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Width="420"
        Height="470"
        MinWidth="360"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        Closed="Window_OnClosed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Height="56"
                    Margin="0,0,0,10"
                    Padding="8,2,8,2"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}"
                    BorderThickness="1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                    <Button x:Name="LanguageButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="LanguageButton_OnClick">
                        <Image x:Name="LanguageButtonImage"
                               Width="24"
                               Height="18"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant" />
                    </Button>
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="ThemeButton_OnClick">
                        <Image x:Name="ThemeButtonImage" Width="20" Height="20" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Content="✕"
                            Click="CloseButton_OnClick" />
                    </StackPanel>

                    <Border DockPanel.Dock="Left"
                            Width="48"
                            Height="48"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Image x:Name="AppIcon"
                               Width="32"
                               Height="32"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="OpacityLabel"
                           Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider"
                            Minimum="20"
                            Maximum="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OpacitySlider_OnValueChanged" />
                    <TextBlock x:Name="OpacityValueText"
                               Grid.Column="1"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <CheckBox x:Name="RunOnStartupCheckBox"
                          Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Checked="RunOnStartupCheckBox_OnChanged"
                          Unchecked="RunOnStartupCheckBox_OnChanged" />
                <CheckBox x:Name="AlwaysOnTopCheckBox"
                          Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Checked="AlwaysOnTopCheckBox_OnChanged"
                          Unchecked="AlwaysOnTopCheckBox_OnChanged" />

                <TextBlock x:Name="TrayIconStyleLabel"
                           Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,18,12,10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button x:Name="TrayIconStyleButton"
                        Grid.Row="3"
                        Grid.Column="1"
                        Height="34"
                        Margin="0,14,0,6"
                        Style="{StaticResource ActionButtonStyle}"
                        HorizontalContentAlignment="Stretch"
                        Click="TrayIconStyleButton_OnClick">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="▾" />
                        <Image x:Name="TrayIconStylePreviewImage"
                               DockPanel.Dock="Left"
                               Width="16"
                               Height="16"
                               Margin="0,0,8,0"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TrayIconStyleValueText"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>

                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SentColorLabel"
                               Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="SentColorButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Height="34"
                            Margin="0,0,0,10"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Click="SentColorButton_OnClick">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="▾" />
                            <Border x:Name="SentColorPreview"
                                    DockPanel.Dock="Left"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="SentColorValueText"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>

                    <TextBlock x:Name="ReceivedColorLabel"
                               Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="ReceivedColorButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="34"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Click="ReceivedColorButton_OnClick">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="▾" />
                            <Border x:Name="ReceivedColorPreview"
                                    DockPanel.Dock="Left"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="ReceivedColorValueText"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
